  "modules": {
    "appearance": true,
    "focus": true,
    "keyboard": true,
    "layout": true,
    "navigation": true,
    "playback": true,
    "player": true,
    "recommendations": true,
    "sidebar": true,
    "typography": true
  },
  "navigation": {
    "compact": true,
    "guideWidth": 0,
    "hideHistory": false,
    "hideHome": false,
    "hideLibrary": false,
    "hideShorts": true,
    "hideSubscriptions": false
  },
  "playback": {
    "autoplay": null,
    "captionFontSize": 130,
    "captions": null,
    "defaultQuality": "720p",
    "defaultSpeed": 1.5,
    "defaultVolume": 80,
    "rememberSpeed": true,
    "rememberVolume": true,
    "speedPresets": [0.5, 1, 1.5, 2]
