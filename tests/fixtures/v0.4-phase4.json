{
  "appearance": {
    "borderRadius": 12,
    "colors": { "accent": "#ff0033" },
    "customCSS": "",
    "customCSSEnabled": false,
    "spacing": 16,
    "theme": "dark",
    "typography": { "fontFamily": "", "fontSize": 110, "fontWeight": 0, "lineHeight": 0 }
  },
  "enabled": true,
  "keyboard": {
    "shortcuts": {
      "resetSpeed": "Shift+R",
      "speedDown": "Shift+<",
      "speedUp": "Shift+>",
      "toggleFocus": "Shift+F",
      "togglePlayerPosition": "Shift+P",
      "toggleSidebar": "Shift+S",
      "toggleTheater": "Shift+T"
