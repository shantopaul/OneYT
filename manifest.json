{
  "action": { "default_popup": "popup/popup.html", "default_title": "OneYT" },
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "css": [
        "content/styles/base.css",
        "content/modules/sidebar/sidebar.css",
        "content/modules/player/player.css",
        "content/modules/layout/layout.css",
        "content/modules/appearance/appearance.css",
        "content/modules/typography/typography.css"
      ],
      "js": [
        "shared/constants.js",
        "shared/defaults.js",
        "shared/selectors.js",
        "shared/storage.js",
        "shared/validators.js",
        "shared/themes.js",
        "content/core/logger.js",
        "content/core/event-bus.js",
        "content/core/dom-manager.js",
        "content/core/settings-manager.js",
        "content/core/page-detector.js",
        "content/core/module-manager.js",
        "content/modules/sidebar/sidebar.js",
        "content/modules/player/player.js",
        "content/modules/layout/layout.js",
        "content/modules/appearance/appearance.js",
        "content/modules/typography/typography.js",
        "content/core/app.js",
        "content/index.js"
      ],
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_idle"
    }
  ],
  "description": "Your YouTube. Your Layout. Your Rules. Customise player, layout, sidebar, themes, playback and focus — privately, locally.",
  "host_permissions": ["https://www.youtube.com/*"],
  "icons": {
    "128": "assets/icons/icon128.png",
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "OneYT — All-in-One YouTube Customizer",
  "permissions": ["storage"],
  "version": "0.1.0"
}
